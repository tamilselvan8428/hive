// =====================================================
// SETUP
// =====================================================

void setup() {

  Serial.begin(115200);

  delay(1000);

  Serial.println();
  Serial.println("=================================================");
  Serial.println("       SMART BEE HIVE SYSTEM");
  Serial.println("=================================================");

  // -------------------------------------------------
  // 1. Initialize Relay / LED
  // -------------------------------------------------

  pinMode(heaterRelayPin, OUTPUT);
  if (ledPin != heaterRelayPin) {
    pinMode(ledPin, OUTPUT);
  }

  // Quick 500ms hardware self-test blink at boot to verify LED connection
  digitalWrite(heaterRelayPin, HIGH);
  delay(500);
  digitalWrite(heaterRelayPin, LOW);

  // Safe startup state
  setHardwareRelay(false);
  setHardwareLed(false);

  Serial.println("[SYSTEM] Heater/LED hardware test complete, initialized OFF.");

  // -------------------------------------------------
  // 2. Initialize DHT11
  // -------------------------------------------------

  dht.begin();

  Serial.println("[SYSTEM] DHT11 initialized.");

  // -------------------------------------------------
  // 3. Initialize pH UART
  // -------------------------------------------------

  mySerial.begin(
    9600,
    SERIAL_8N1,
    RXD2,
    TXD2
  );

  Serial.println("[SYSTEM] pH UART initialized.");

  // -------------------------------------------------
  // 4. Initialize HX711
  // -------------------------------------------------

  scale.begin(
    HX711_DOUT,
    HX711_SCK
  );

  Serial.println("[SYSTEM] Initializing load cell...");

  if (scale.is_ready()) {

    Serial.println("[HX711] Connected.");

    scale.set_scale(calibrationFactor);

    scale.tare();

    Serial.println("[HX711] Tare completed.");

  } else {

    Serial.println("[HX711] WARNING: HX711 not detected.");

  }

  // -------------------------------------------------
  // 5. Connect to WiFi
  // -------------------------------------------------

  Serial.print("[WiFi] Connecting to: ");
  Serial.println(ssid);

  WiFi.begin(
    ssid,
    password
  );

  int attempts = 0;

  while (
    WiFi.status() != WL_CONNECTED &&
    attempts < 30
  ) {

    delay(500);

    Serial.print(".");

    attempts++;
  }

  if (WiFi.status() == WL_CONNECTED) {

    Serial.println();
    Serial.println("[WiFi] Connected successfully!");

    Serial.print("[WiFi] ESP32 IP: ");
    Serial.println(WiFi.localIP());

  } else {

    Serial.println();
    Serial.println("[WiFi] Connection failed.");
    Serial.println("[WiFi] Will retry automatically.");

  }

  Serial.println("=================================================");
  Serial.println("SYSTEM READY - Backend Controlled Architecture");
  Serial.println("Decision logic: Spring Boot Backend -> ESP32 Actuation");
  Serial.println("=================================================");
}

// =====================================================
// HARDWARE RELAY / LED CONTROL
// =====================================================

void updatePhysicalPins() {
  if (heaterRelayPin == ledPin) {
    // Both relay and LED mapped to same pin (e.g. GPIO 2 built-in LED)
    bool active = burnerState || ledState;
    digitalWrite(
      heaterRelayPin,
      RELAY_ACTIVE_LOW ? (active ? LOW : HIGH) : (active ? HIGH : LOW)
    );
  } else {
    // Separate Relay and LED pins
    digitalWrite(
      heaterRelayPin,
      RELAY_ACTIVE_LOW ? (burnerState ? LOW : HIGH) : (burnerState ? HIGH : LOW)
    );
    digitalWrite(
      ledPin,
      ledState ? HIGH : LOW
    );
  }
}

void setHardwareRelay(bool state) {
  burnerState = state;
  updatePhysicalPins();
}

void setHardwareLed(bool state) {
  ledState = state;
  updatePhysicalPins();
}


// =====================================================
// SENSOR READING
// =====================================================

void readAndUploadSensors() {

  Serial.println();
  Serial.println("=================================================");
  Serial.println("READING SENSORS");
  Serial.println("=================================================");

  // =================================================
  // 1. READ pH SENSOR
  // =================================================

  String sensorData = "";

  unsigned long startWait =
    millis();

  while (
    millis() - startWait < 150
  ) {

    while (
      mySerial.available()
    ) {

      char c =
        mySerial.read();

      sensorData += c;
    }

    delay(10);
  }

  phValue =
    extractPH(sensorData);

  // =================================================
  // 2. READ HX711 WEIGHT
  // =================================================

  if (scale.is_ready()) {

    weight =
      scale.get_units(5);

    // Prevent negative weight
    if (weight < 0) {

      weight = 0.0;
    }

  } else {

    weight = NAN;
  }

  // =================================================
  // 3. READ DHT11
  // =================================================

  temperature =
    dht.readTemperature();

  humidity =
    dht.readHumidity();

  // =================================================
  // PRINT SENSOR VALUES
  // =================================================

  Serial.print(
    "Temperature: "
  );

  if (!isnan(temperature)) {

    Serial.print(
      temperature,
      1
    );

    Serial.println(
      " C"
    );

  } else {

    Serial.println(
      "DHT11 ERROR"
    );
  }

  // -------------------------------------------------

  Serial.print(
    "Humidity:    "
  );

  if (!isnan(humidity)) {

    Serial.print(
      humidity,
      1
    );

    Serial.println(
      " %"
    );

  } else {

    Serial.println(
      "DHT11 ERROR"
    );
  }

  // -------------------------------------------------

  Serial.print(
    "pH Value:    "
  );

  if (!isnan(phValue)) {

    Serial.println(
      phValue,
      2
    );

  } else {

    Serial.println(
      "UART Offline"
    );
  }

  // -------------------------------------------------

  Serial.print(
    "Hive Weight: "
  );

  if (!isnan(weight)) {

    Serial.print(
      weight,
      2
    );

    Serial.println(
      " kg"
    );

  } else {

    Serial.println(
      "HX711 Offline"
    );
  }

  Serial.println(
    "======================================"
  );


  // =================================================
  // 4. HARDWARE IS SENSOR REPORTER & ACTUATOR ONLY
  // =================================================
  // The ESP32 does NOT autonomously make ON/OFF decisions based on temperature.
  // Software (Dashboard / Backend) evaluates sensor telemetry and transmits
  // control commands via ThingSpeak. The ESP32 strictly actuates incoming commands.

  // =================================================
  // 5. UPLOAD TO THINGSPEAK
  // =================================================

  uploadToThingSpeak();
}

// =====================================================
// MAIN LOOP
// =====================================================

void loop() {

  // =================================================
  // WiFi Connection Check
  // =================================================

  if (
    WiFi.status() != WL_CONNECTED
  ) {

    Serial.println(
      "[WiFi] Disconnected! Reconnecting..."
    );

    WiFi.reconnect();

    delay(2000);

    return;
  }

  unsigned long currentMillis =
    millis();

  // =================================================
  // 1. FETCH THINGSPEAK CONTROL
  // Every 5 seconds
  // =================================================

  if (
    currentMillis -
      lastControlPollTime >=
      controlPollInterval
    ||
    lastControlPollTime == 0
  ) {

    lastControlPollTime =
      currentMillis;

    fetchControlCommands();
  }

  // =================================================
  // 2. READ SENSORS
  // Every 15 seconds
  // =================================================

  if (
    currentMillis -
      lastSensorReadTime >=
      sensorReadInterval
    ||
    lastSensorReadTime == 0
  ) {

    lastSensorReadTime =
      currentMillis;

    readAndUploadSensors();
  }

  delay(50);
}

// =====================================================
// THINGSPEAK UPLOAD
//
// Field 1 = Device / Farm ID
// Field 2 = Temperature
// Field 3 = Humidity
// Field 4 = pH
// Field 5 = Weight
// Field 6 = Heater / LED State
// Field 7 = Control Mode
// Field 8 = Manual Heater Command
// =====================================================

void uploadToThingSpeak() {

  if (
    WiFi.status() != WL_CONNECTED
  ) {

    return;
  }

  HTTPClient http;

  String url =
    String(thingSpeakServer) +

    "?api_key=" +
    String(thingSpeakWriteKey) +

    "&field1=" +
    String(deviceFarmId) +

    "&field2=" +
    (
      isnan(temperature)
        ? "0.00"
        : String(temperature, 2)
    ) +

    "&field3=" +
    (
      isnan(humidity)
        ? "0.00"
        : String(humidity, 2)
    ) +

    "&field4=" +
    (
      isnan(phValue)
        ? "0.00"
        : String(phValue, 2)
    ) +

    "&field5=" +
    (
      isnan(weight)
        ? "0.00"
        : String(weight, 2)
    );

  http.begin(url);

  int httpCode =
    http.GET();

  if (httpCode > 0) {

    String response =
      http.getString();

    if (response != "0") {

      Serial.println(
        "[THINGSPEAK] Upload successful. Entry: "
        + response
      );

    } else {

      Serial.println(
        "[THINGSPEAK] Rate limited. Wait 15 seconds."
      );
    }

  } else {

    Serial.print(
      "[THINGSPEAK] Upload failed: "
    );

    Serial.println(
      httpCode
    );
  }

  http.end();
}

// =====================================================
// FETCH CONTROL COMMANDS
//
// Field 7:
// 0 = AUTO
// 1 = MANUAL
//
// Field 8:
// 0 = OFF
// 1 = ON
// =====================================================

void fetchControlCommands() {

  if (
    WiFi.status() != WL_CONNECTED
  ) {

    return;
  }

  HTTPClient http;

  if (
    http.begin(
      thingSpeakField6Url
    )
  ) {

    http.setTimeout(4000);

    int httpCode =
      http.GET();

    if (
      httpCode == HTTP_CODE_OK
    ) {

      String response =
        http.getString();
      response.trim();

      if (response == "1" || response == "0") {
        bool commandOn = (response == "1");

        if (commandOn != burnerState || isFirstRun) {
          burnerState = commandOn;
          ledState = commandOn;
          updatePhysicalPins();
          Serial.print("[ACTUATOR TRIGGERED] Field 6 Command -> ");
          Serial.println(commandOn ? "LED & HEATER ON" : "LED & HEATER OFF");
        }
        isFirstRun = false;
      }
    } else {
      Serial.print("[THINGSPEAK] Poll failed, HTTP: ");
      Serial.println(httpCode);
    }

    http.end();
  }
}

// =====================================================
// EXTRACT pH VALUE
// Expected format:
//
// PH:7.25
//
// or
//
// PH:7.25,...
// =====================================================

float extractPH(String data) {

  int phIndex =
    data.indexOf("PH:");

  if (
    phIndex == -1
  ) {

    return NAN;
  }

  int commaIndex =
    data.indexOf(
      ',',
      phIndex
    );

  String phString;

  if (
    commaIndex != -1
  ) {

    phString =
      data.substring(
        phIndex + 3,
        commaIndex
      );

  } else {

    phString =
      data.substring(
        phIndex + 3
      );
  }

  phString.trim();

  float value =
    phString.toFloat();

  // Valid pH range
  if (
    value <= 0 ||
    value > 14
  ) {

    return NAN;
  }

  return value;
} 