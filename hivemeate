// =====================================================
// SETUP
// =====================================================

void setup() {

  Serial.begin(115200);

  delay(1000);

  Serial.println();
  Serial.println("=================================================");
  Serial.println("       SMART BEE HIVE SYSTEM");
  Serial.println("=================================================");

  // -------------------------------------------------
  // 1. Initialize Relay / LED
  // -------------------------------------------------

  pinMode(heaterRelayPin, OUTPUT);

  // Safe startup state
  setHardwareRelay(false);

  Serial.println("[SYSTEM] Heater/LED initialized OFF.");

  // -------------------------------------------------
  // 2. Initialize DHT11
  // -------------------------------------------------

  dht.begin();

  Serial.println("[SYSTEM] DHT11 initialized.");

  // -------------------------------------------------
  // 3. Initialize pH UART
  // -------------------------------------------------

  mySerial.begin(
    9600,
    SERIAL_8N1,
    RXD2,
    TXD2
  );

  Serial.println("[SYSTEM] pH UART initialized.");

  // -------------------------------------------------
  // 4. Initialize HX711
  // -------------------------------------------------

  scale.begin(
    HX711_DOUT,
    HX711_SCK
  );

  Serial.println("[SYSTEM] Initializing load cell...");

  if (scale.is_ready()) {

    Serial.println("[HX711] Connected.");

    scale.set_scale(calibrationFactor);

    scale.tare();

    Serial.println("[HX711] Tare completed.");

  } else {

    Serial.println("[HX711] WARNING: HX711 not detected.");

  }

  // -------------------------------------------------
  // 5. Connect to WiFi
  // -------------------------------------------------

  Serial.print("[WiFi] Connecting to: ");
  Serial.println(ssid);

  WiFi.begin(
    ssid,
    password
  );

  int attempts = 0;

  while (
    WiFi.status() != WL_CONNECTED &&
    attempts < 30
  ) {

    delay(500);

    Serial.print(".");

    attempts++;
  }

  if (WiFi.status() == WL_CONNECTED) {

    Serial.println();
    Serial.println("[WiFi] Connected successfully!");

    Serial.print("[WiFi] ESP32 IP: ");
    Serial.println(WiFi.localIP());

  } else {

    Serial.println();
    Serial.println("[WiFi] Connection failed.");
    Serial.println("[WiFi] Will retry automatically.");

  }

  Serial.println("=================================================");
  Serial.println("SYSTEM READY - Backend Controlled Architecture");
  Serial.println("Decision logic: Spring Boot Backend -> ESP32 Actuation");
  Serial.println("=================================================");
}

// =====================================================
// HARDWARE RELAY / LED CONTROL
// =====================================================

void setHardwareRelay(bool state) {

  if (RELAY_ACTIVE_LOW) {

    digitalWrite(
      heaterRelayPin,
      state ? LOW : HIGH
    );

  } else {

    digitalWrite(
      heaterRelayPin,
      state ? HIGH : LOW
    );
  }
}

void setHardwareLed(bool state) {
  if (ledPin != heaterRelayPin) {
    digitalWrite(
      ledPin,
      state ? HIGH : LOW
    );
  } else {
    // If sharing Pin 2, either heater or led ON keeps Pin 2 active
    bool active = burnerState || ledState;
    digitalWrite(
      heaterRelayPin,
      RELAY_ACTIVE_LOW ? (active ? LOW : HIGH) : (active ? HIGH : LOW)
    );
  }
}


// =====================================================
// SENSOR READING
// =====================================================

void readAndUploadSensors() {

  Serial.println();
  Serial.println("=================================================");
  Serial.println("READING SENSORS");
  Serial.println("=================================================");

  // =================================================
  // 1. READ pH SENSOR
  // =================================================

  String sensorData = "";

  unsigned long startWait =
    millis();

  while (
    millis() - startWait < 150
  ) {

    while (
      mySerial.available()
    ) {

      char c =
        mySerial.read();

      sensorData += c;
    }

    delay(10);
  }

  phValue =
    extractPH(sensorData);

  // =================================================
  // 2. READ HX711 WEIGHT
  // =================================================

  if (scale.is_ready()) {

    weight =
      scale.get_units(5);

    // Prevent negative weight
    if (weight < 0) {

      weight = 0.0;
    }

  } else {

    weight = NAN;
  }

  // =================================================
  // 3. READ DHT11
  // =================================================

  temperature =
    dht.readTemperature();

  humidity =
    dht.readHumidity();

  // =================================================
  // PRINT SENSOR VALUES
  // =================================================

  Serial.print(
    "Temperature: "
  );

  if (!isnan(temperature)) {

    Serial.print(
      temperature,
      1
    );

    Serial.println(
      " C"
    );

  } else {

    Serial.println(
      "DHT11 ERROR"
    );
  }

  // -------------------------------------------------

  Serial.print(
    "Humidity:    "
  );

  if (!isnan(humidity)) {

    Serial.print(
      humidity,
      1
    );

    Serial.println(
      " %"
    );

  } else {

    Serial.println(
      "DHT11 ERROR"
    );
  }

  // -------------------------------------------------

  Serial.print(
    "pH Value:    "
  );

  if (!isnan(phValue)) {

    Serial.println(
      phValue,
      2
    );

  } else {

    Serial.println(
      "UART Offline"
    );
  }

  // -------------------------------------------------

  Serial.print(
    "Hive Weight: "
  );

  if (!isnan(weight)) {

    Serial.print(
      weight,
      2
    );

    Serial.println(
      " kg"
    );

  } else {

    Serial.println(
      "HX711 Offline"
    );
  }

  Serial.println(
    "======================================"
  );


  // =================================================
  // 5. UPLOAD TO THINGSPEAK
  // =================================================

  uploadToThingSpeak();
}

// =====================================================
// MAIN LOOP
// =====================================================

void loop() {

  // =================================================
  // WiFi Connection Check
  // =================================================

  if (
    WiFi.status() != WL_CONNECTED
  ) {

    Serial.println(
      "[WiFi] Disconnected! Reconnecting..."
    );

    WiFi.reconnect();

    delay(2000);

    return;
  }

  unsigned long currentMillis =
    millis();

  // =================================================
  // 1. FETCH THINGSPEAK CONTROL
  // Every 5 seconds
  // =================================================

  if (
    currentMillis -
      lastControlPollTime >=
      controlPollInterval
    ||
    lastControlPollTime == 0
  ) {

    lastControlPollTime =
      currentMillis;

    fetchControlCommands();
  }

  // =================================================
  // 2. READ SENSORS
  // Every 15 seconds
  // =================================================

  if (
    currentMillis -
      lastSensorReadTime >=
      sensorReadInterval
    ||
    lastSensorReadTime == 0
  ) {

    lastSensorReadTime =
      currentMillis;

    readAndUploadSensors();
  }

  delay(50);
}

// =====================================================
// THINGSPEAK UPLOAD
//
// Field 1 = Device / Farm ID
// Field 2 = Temperature
// Field 3 = Humidity
// Field 4 = pH
// Field 5 = Weight
// Field 6 = Heater / LED State
// Field 7 = Control Mode
// Field 8 = Manual Heater Command
// =====================================================

void uploadToThingSpeak() {

  if (
    WiFi.status() != WL_CONNECTED
  ) {

    return;
  }

  HTTPClient http;

  String url =
    String(thingSpeakServer) +

    "?api_key=" +
    String(thingSpeakWriteKey) +

    "&field1=" +
    String(deviceFarmId) +

    "&field2=" +
    (
      isnan(temperature)
        ? "0.00"
        : String(temperature, 2)
    ) +

    "&field3=" +
    (
      isnan(humidity)
        ? "0.00"
        : String(humidity, 2)
    ) +

    "&field4=" +
    (
      isnan(phValue)
        ? "0.00"
        : String(phValue, 2)
    ) +

    "&field5=" +
    (
      isnan(weight)
        ? "0.00"
        : String(weight, 2)
    ) +

    "&field6=" +
    String(
      burnerState
        ? "1"
        : "0"
    ) +

    "&field7=" +
    String(
      controlMode == "MANUAL"
        ? "1"
        : "0"
    ) +

    "&field8=" +
    String(
      ledState
        ? "1"
        : "0"
    );

  http.begin(url);

  int httpCode =
    http.GET();

  if (httpCode > 0) {

    String response =
      http.getString();

    if (response != "0") {

      Serial.println(
        "[THINGSPEAK] Upload successful. Entry: "
        + response
      );

    } else {

      Serial.println(
        "[THINGSPEAK] Rate limited. Wait 15 seconds."
      );
    }

  } else {

    Serial.print(
      "[THINGSPEAK] Upload failed: "
    );

    Serial.println(
      httpCode
    );
  }

  http.end();
}

// =====================================================
// FETCH CONTROL COMMANDS
//
// Field 7:
// 0 = AUTO
// 1 = MANUAL
//
// Field 8:
// 0 = OFF
// 1 = ON
// =====================================================

void fetchControlCommands() {

  if (
    WiFi.status() != WL_CONNECTED
  ) {

    return;
  }

  HTTPClient http;

  if (
    http.begin(
      thingSpeakLastFeedUrl
    )
  ) {

    http.setTimeout(3000);

    int httpCode =
      http.GET();

    if (
      httpCode == HTTP_CODE_OK
    ) {

      String response =
        http.getString();

      // =================================================
      // ArduinoJson compatibility
      // =================================================

#if ARDUINOJSON_VERSION_MAJOR >= 7

      JsonDocument doc;

#else

      StaticJsonDocument<512> doc;

#endif

      DeserializationError error =
        deserializeJson(
          doc,
          response
        );

      if (!error) {

        // ===============================================
        // FIELD 7 - CONTROL MODE
        // ===============================================

        if (
          doc.containsKey("field7") &&
          !doc["field7"].isNull()
        ) {

          const char* f7 =
            doc["field7"];

          String newMode =
            (
              strcmp(f7, "1") == 0
            )
            ? "MANUAL"
            : "AUTO";

          if (
            newMode != controlMode
          ) {

            controlMode =
              newMode;

            Serial.print(
              "[THINGSPEAK] Control mode: "
            );

            Serial.println(
              controlMode
            );
          }
        }

        // ===============================================
        // ===============================================
        // FIELD 6 - HEATER COMMAND
        // ===============================================
        if (doc.containsKey("field6") && !doc["field6"].isNull()) {
          const char* f6 = doc["field6"];
          bool newHeater = (strcmp(f6, "1") == 0);
          if (burnerState != newHeater || isFirstRun) {
            burnerState = newHeater;
            setHardwareRelay(burnerState);
            previousBurnerState = burnerState;

            Serial.print("[THINGSPEAK] Mode: ");
            Serial.print(controlMode);
            Serial.print(" | Heater (Field 6): ");
            Serial.println(burnerState ? "ON" : "OFF");
          }
        }

        // ===============================================
        // FIELD 8 - LED COMMAND
        // ===============================================
        if (doc.containsKey("field8") && !doc["field8"].isNull()) {
          const char* f8 = doc["field8"];
          bool newLed = (strcmp(f8, "1") == 0);
          if (ledState != newLed || isFirstRun) {
            ledState = newLed;
            setHardwareLed(ledState);
            previousLedState = ledState;

            Serial.print("[THINGSPEAK] Mode: ");
            Serial.print(controlMode);
            Serial.print(" | LED (Field 8): ");
            Serial.println(ledState ? "ON" : "OFF");
          }
        }
        isFirstRun = false;

      } else {

        Serial.println(
          "[THINGSPEAK] JSON parse error."
        );
      }
    }

    http.end();
  }
}

// =====================================================
// EXTRACT pH VALUE
// Expected format:
//
// PH:7.25
//
// or
//
// PH:7.25,...
// =====================================================

float extractPH(String data) {

  int phIndex =
    data.indexOf("PH:");

  if (
    phIndex == -1
  ) {

    return NAN;
  }

  int commaIndex =
    data.indexOf(
      ',',
      phIndex
    );

  String phString;

  if (
    commaIndex != -1
  ) {

    phString =
      data.substring(
        phIndex + 3,
        commaIndex
      );

  } else {

    phString =
      data.substring(
        phIndex + 3
      );
  }

  phString.trim();

  float value =
    phString.toFloat();

  // Valid pH range
  if (
    value <= 0 ||
    value > 14
  ) {

    return NAN;
  }

  return value;
} 