// HX711 Load Cell
// =====================================================

#define HX711_DOUT 18
#define HX711_SCK  19

HX711 scale;

// Change this value according to your load-cell calibration
float calibrationFactor = -7050.0;

// Decision logic (AUTO threshold >35C and MANUAL overrides) is managed by the Spring Boot Backend.
// ESP32 executes commands sent by the backend via ThingSpeak.

// =====================================================
// Control Mode
// =====================================================

// AUTO or MANUAL

String controlMode = "AUTO";

// Current physical heater state (ThingSpeak Field 6)
bool burnerState = false;

// Current physical LED state (ThingSpeak Field 8)
bool ledState = false;

// Previous states
bool previousBurnerState = false;
bool previousLedState = false;
 
// First run flag
bool isFirstRun = true;

// Manual command from ThingSpeak
bool manualHeaterCommand = false;

